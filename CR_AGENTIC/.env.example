# Agent API
AGENT_API_PORT=3100
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ISSUER=course-rep
JWT_AUDIENCE=course-rep-users

# Agent PostgreSQL
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5433/cr_agent?schema=public

# Redis (shared with main app; BullMQ uses cr:agent: prefix)
REDIS_HOST=localhost
REDIS_PORT=6379

# Main Course Rep API (internal integration)
COURSE_REP_API_URL=http://localhost:3000
INTERNAL_API_SECRET=change-me-internal-secret

# S3 / compatible storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=cr-agent-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SESSION_ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-gcm

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Portal discovery (web search backend, e.g. Serper.dev)
PORTAL_SEARCH_API_KEY=
PORTAL_SEARCH_ENDPOINT=https://google.serper.dev/search

# Browser worker
BROWSER_MAX_CONTEXTS=50
BROWSER_HEADLESS=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
